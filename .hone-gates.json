{
  "gates": [
    {
      "name": "format",
      "command": "cargo fmt --all -- --check",
      "required": true
    },
    {
      "name": "clippy",
      "command": "cargo clippy --locked --all-targets --all-features -- -D warnings",
      "required": true
    },
    {
      "name": "test",
      "command": "cargo test --locked --all-targets --all-features",
      "required": true
    },
    {
      "name": "release-build",
      "command": "cargo build --locked --release --bins",
      "required": true
    },
    {
      "name": "collection-tests",
      "command": "python3 -m unittest discover -s benchmarks -p 'test_collection_validation.py'",
      "required": true
    },
    {
      "name": "docs",
      "command": "mdbook build book",
      "required": true
    }
  ]
}
