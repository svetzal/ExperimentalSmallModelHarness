--- /dev/null
+++ b/Benchmarks/deep-swe/scripts/test_microgentic_adapter.py
@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+import json
+import shlex
+from dataclasses import dataclass
+from pathlib import Path
+
+import pytest
+from adapter.adaptive_harness_agent import AdaptiveHarnessAgent
+from pier.models.agent.context import AgentContext
+
+
+@dataclass
+class Result:
+    return_code: int = 0
+    stdout: str = ""
+    stderr: str = ""
+
+
+class Environment:
+    def __init__(self):
+        self.commands = []
+        self.uploads = {}
+
+    def agent_process_env(self, values):
+        return values
+
+    async def upload_file(self, source_path, target_path):
+        self.uploads[target_path] = Path(source_path).read_bytes()
+
+    async def exec(self, command, **kwargs):
+        self.commands.append(command)
+        return Result()
+
+
+@pytest.mark.asyncio
+async def test_public_prompt_and_controls_preserve_the_registered_contract(tmp_path):
+    binary = tmp_path / "microgentic"
+    binary.write_bytes(b"test-binary")
+    binary.with_name("ca-certificates.crt").write_bytes(b"test-ca")
+    agent = AdaptiveHarnessAgent(logs_dir=tmp_path / "logs", binary_path=binary,
+                                 model_name="ollama/qwen-test", num_predict=8192,
+                                 max_model_interactions=23)
+    environment = Environment()
+    prompt = "Preserve this: 'quotes', $(literal), `literal`, and Unicode 世界.\nNext line."
+    context = AgentContext()
+    await agent.run(prompt, environment, context)
+    contract = json.loads(environment.uploads[agent.REMOTE_CONTRACT])
+    assert contract["guidance"] == prompt
+    assert contract["profile"]["id"] == "terminal_work"
+    assert contract["probes"] == []
+    command = next(c for c in environment.commands if "/installed-agent/microgentic run" in c)
+    args = shlex.split(command)
+    assert args[args.index("--prompt") + 1] == prompt
+    assert args[args.index("--provider") + 1] == "ollama"
+    assert args[args.index("--dir") + 1] == "."
+    assert args[args.index("--max-tokens") + 1] == "8192"
+    assert args[args.index("--max-model-interactions") + 1] == "23"
+    assert "--json" in args
+    assert context.metadata["provider"] == "ollama"
+    assert context.metadata["workspace_snapshot"] == "committed_after_agent_exit"
+
+
+def test_selected_provider_routes_network_and_model_prefix(tmp_path):
+    binary = tmp_path / "microgentic"
+    binary.write_bytes(b"test-binary")
+    binary.with_name("ca-certificates.crt").write_bytes(b"test-ca")
+    agent = AdaptiveHarnessAgent(logs_dir=tmp_path / "logs", binary_path=binary,
+                                 model_name="omlx/test", provider="omlx",
+                                 extra_env={"OMLX_HOST": "http://my-omlx.example:8000"})
+    assert agent._ollama_model() == "test"
+    assert agent.network_allowlist().domains == ["my-omlx.example"]
